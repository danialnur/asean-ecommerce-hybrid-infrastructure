# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*~
.vscode/

# Python bytecode cache
__pycache__/
*.pyc

# Certification-guide PDFs - kept locally, not published on GitHub.
# Every phase's docs/ only ever holds these PDFs now (screenshots.md +
# screenshots/ moved to evidences/ in all 4 phases), so each phase's whole
# docs/ folder is excluded.
01-regional-on-premises-network/docs/
02-security-hardening/docs/
03-aws-cloud-infrastructure/docs/
04-automation-and-secops/docs/

# Terraform - local provider cache and state (never commit state, even
# from local LocalStack testing - .terraform.lock.hcl IS committed)
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfvars
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
